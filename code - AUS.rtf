.rr.cur\{background:var(--navy-pale)\}\
.rr.cur .rl2\{font-weight:600\}\
.rr.done\{color:var(--faint)\}\
.rr.done .rl2\{text-decoration:line-through;text-decoration-color:var(--rule)\}\
.mk\{color:var(--cl);font-weight:700;font-family:var(--d);letter-spacing:-1px\}\
\
/* ---------- admin ---------- */\
.acard\{border:1px solid var(--rule);margin-bottom:20px\}\
.ahd\{background:var(--band);border-bottom:1px solid var(--rule);padding:11px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\}\
.ahd .t\{font-size:10px;letter-spacing:0.15em;text-transform:uppercase;font-weight:600;color:var(--navy)\}\
.ahd .n\{font-size:11px;color:var(--faint);letter-spacing:0.08em\}\
.abody\{padding:16px\}\
.ted\{display:grid;grid-template-columns:1fr 74px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--rule)\}\
.ted:last-child\{border:none\}\
.ted .nm2\{font-size:15.5px;display:flex;gap:8px;align-items:center\}\
.ted input\{width:100%;border:1px solid var(--rule);padding:5px 8px;text-align:right;background:#FCFBF7;font-size:14px\}\
.ted input:focus\{outline:none;border-color:var(--navy)\}\
.sed\{display:grid;grid-template-columns:1fr 220px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--rule)\}\
.sed:last-child\{border:none\}\
.sed .nm2\{font-size:15.5px\}\
.sed input\{width:100%;border:1px solid var(--rule);padding:6px 8px;background:#FCFBF7;font-size:14px\}\
.sed input:focus\{outline:none;border-color:var(--navy)\}\
.tsum\{display:flex;gap:24px;margin-top:14px;padding-top:12px;border-top:1px solid var(--rule);font-size:13px;color:var(--faint);letter-spacing:0.06em;text-transform:uppercase\}\
.tsum b\{color:var(--ink);font-weight:600\}\
.tsum b.over\{color:var(--cl)\}\
.rep\{border-bottom:1px solid var(--rule);padding:14px 0\}\
.rep:last-child\{border:none\}\
.rep .rh\{display:flex;justify-content:space-between;gap:12px;margin-bottom:5px;flex-wrap:wrap\}\
.rep .id\{font-size:11px;letter-spacing:0.1em;color:var(--faint);text-transform:uppercase\}\
.rep .tg\{font-size:9px;letter-spacing:0.11em;text-transform:uppercase;font-weight:600;padding:2px 7px\}\
.rep .tg.new\{background:var(--cl-pale);color:var(--cl)\}\
.rep .tg.seen\{background:var(--band);color:var(--faint)\}\
.rep .bd\{font-size:15.5px\}\
.rep .mt\{font-size:12.5px;color:var(--faint);margin-top:5px;font-style:italic\}\
\
.pres\{border-top:1px solid var(--rule)\}\
.pr\{display:grid;grid-template-columns:110px 1fr auto;gap:14px;align-items:baseline;padding:13px 0;border-bottom:1px solid var(--rule)\}\
.pr .y\{font-size:12px;letter-spacing:0.1em;color:var(--faint);font-weight:600\}\
.pr .n2\{font-family:var(--d);font-size:20px;font-weight:600\}\
.pr .t2\{font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold-dk);font-weight:600\}\
\
footer\{background:var(--navy);color:var(--navy-mid);margin-top:40px\}\
footer .fw\{max-width:940px;margin:0 auto;padding:20px 28px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:10px;letter-spacing:0.13em;text-transform:uppercase\}\
footer button\{color:var(--gold);text-decoration:underline;text-underline-offset:3px;font-size:10px;letter-spacing:0.13em;text-transform:uppercase\}\
\
/* ---------- public top-bar auth ---------- */\
.bauth\{display:flex;gap:10px;align-items:center\}\
.topbtn\{font-size:10.5px;letter-spacing:0.14em;text-transform:uppercase;font-weight:600;padding:8px 15px;border:1px solid rgba(212,175,55,.5);color:var(--gold);white-space:nowrap\}\
.topbtn:hover\{background:rgba(212,175,55,.12)\}\
.topbtn.solid\{background:var(--gold);color:var(--navy);border-color:var(--gold)\}\
.topbtn.solid:hover\{background:var(--gold-soft);border-color:var(--gold-soft)\}\
\
/* ---------- auth modal ---------- */\
.authwrap\{position:fixed;inset:0;z-index:80;display:none;align-items:flex-start;justify-content:center;padding:6vh 16px 24px;\
  background:rgba(14,24,43,.74);backdrop-filter:blur(3px);overflow-y:auto\}\
.authwrap.on\{display:flex\}\
.authcard\{position:relative;width:100%;max-width:452px;color:var(--cream);padding:44px 38px 36px;border:1px solid rgba(212,175,55,.22);\
  background:radial-gradient(ellipse at 50% 22%, #1E3151 0%, #16243F 62%, #0E1A31 100%)\}\
.authcard:before\{content:"";position:absolute;inset:5px;border:1px solid rgba(212,175,55,.10);pointer-events:none\}\
.authclose\{position:absolute;top:10px;right:14px;font-size:24px;line-height:1;color:var(--navy-mid);z-index:2;padding:4px 8px\}\
.authclose:hover\{color:var(--gold)\}\
.demohint\{margin-top:16px;padding:9px 12px;border:1px dashed rgba(212,175,55,.35);font-size:12px;color:var(--gold-soft);letter-spacing:0.03em;text-align:center\}\
\
/* ---------- home / landing ---------- */\
.lead-in\{font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:16px\}\
.how\{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule);margin-bottom:14px\}\
.how .c2\{background:var(--paper);padding:24px 22px\}\
.how .c2 .n\{font-family:var(--d);font-weight:700;font-size:23px;color:var(--gold-dk);line-height:1;margin-bottom:14px\}\
.how .c2 .t\{font-family:var(--d);font-weight:600;font-size:19px;color:var(--navy);margin-bottom:7px;line-height:1.25\}\
.how .c2 .w\{font-size:15px;color:var(--muted);line-height:1.55\}\
.stats\{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--rule);background:var(--band)\}\
.stat\{padding:28px 18px;text-align:center;border-right:1px solid var(--rule)\}\
.stat:last-child\{border-right:none\}\
.stat .v\{font-family:var(--d);font-weight:700;font-size:42px;color:var(--navy);line-height:1\}\
.stat .l\{font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:var(--faint);font-weight:600;margin-top:8px\}\
.joincta\{background:var(--navy);color:var(--cream);padding:28px 26px;display:flex;justify-content:space-between;align-items:center;gap:22px;flex-wrap:wrap;position:relative;margin-top:26px\}\
.joincta:after\{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--gold)\}\
.joincta .jt\{font-family:var(--d);font-weight:600;font-size:26px;max-width:24ch;line-height:1.2\}\
.joincta .js\{font-size:14.5px;color:var(--navy-mid);margin-top:7px;max-width:44ch\}\
.reqch\{border:1px solid var(--rule);background:var(--band);border-left:3px solid var(--gold);padding:18px 20px;margin-top:18px\}\
.reqch .rt2\{font-family:var(--d);font-weight:600;font-size:20px;color:var(--navy);margin-bottom:4px\}\
.reqch .rw2\{font-size:15px;color:var(--muted);max-width:60ch;margin-bottom:14px\}\
.rostmore\{font-size:12.5px;color:var(--faint);letter-spacing:0.04em;margin-top:10px;font-style:italic\}\
\
/* ---------- wordmark ---------- */\
.the\{font-family:var(--d);font-style:italic;font-weight:500;text-transform:none\}\
.nm .the\{font-size:16px;letter-spacing:.01em;color:var(--gold-soft);margin-right:4px\}\
\
/* ---------- home splash (grand entrance) ---------- */\
#home.page\{padding-top:0\}\
#homeMember\{padding-top:40px\}\
.splash\{background:radial-gradient(ellipse at 50% 30%, #1E3151 0%, #16243F 60%, #0E1A31 100%);color:var(--cream);text-align:center;padding:84px 20px 88px;border-bottom:2px solid var(--gold)\}\
.splash .mark.xl\{width:100px;height:100px;flex:0 0 100px;margin:0 auto 30px;display:block\}\
.wm\{font-family:var(--d);line-height:1;color:var(--cream)\}\
.wm .the\{display:block;font-size:40px;letter-spacing:.02em;color:var(--gold-soft);margin-bottom:12px\}\
.wm .nmx\{display:block;font-weight:600;font-size:66px;letter-spacing:.15em;text-transform:uppercase\}\
.splash-tag\{font-family:var(--d);font-size:21px;font-weight:500;line-height:1.4;color:var(--gold-soft);margin:24px auto 0;max-width:40ch\}\
.splash-cta\{display:flex;gap:14px;justify-content:center;margin-top:38px;flex-wrap:wrap\}\
.splash-cta .topbtn\{padding:13px 26px;font-size:11px\}\
\
/* ---------- mission statement ---------- */\
.manifesto\{max-width:60ch;margin:58px auto 8px;text-align:center\}\
.manifesto p\{font-family:var(--d);font-weight:500;font-size:25px;line-height:1.42;color:var(--navy)\}\
.manifesto .amp\{display:inline-block;margin-top:20px;font-family:var(--b);font-size:15px;color:var(--gold-dk);text-decoration:underline;text-underline-offset:3px\}\
\
/* ---------- about page (Oxford-style) ---------- */\
#about.page\{padding-top:0\}\
.abhero\{background:radial-gradient(ellipse at 50% 45%, #1E3151 0%, #16243F 62%, #0E1A31 100%);color:var(--cream);text-align:center;padding:72px 20px 76px;border-bottom:2px solid var(--gold)\}\
.abhero h2\{font-family:var(--d);font-weight:600;font-size:46px;letter-spacing:.02em;line-height:1.08\}\
.about-body\{max-width:66ch;margin:0 auto;padding-top:56px;text-align:center\}\
.about-body .lede\{font-family:var(--d);font-weight:600;font-size:33px;line-height:1.2;color:var(--navy);margin-bottom:22px\}\
.flr\{display:block;margin:0 auto 32px;color:var(--gold)\}\
.about-body p\{font-size:17px;line-height:1.75;color:var(--ink);margin-bottom:22px\}\
.about-body p.lks\{color:var(--muted);font-size:16px\}\
.about-body a.lk\{color:var(--gold-dk);text-decoration:underline;text-underline-offset:2px\}\
.about-cta\{margin-top:38px\}\
.bigjoin\{display:inline-block;background:var(--gold);color:var(--navy);font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;padding:16px 44px\}\
.bigjoin:hover\{background:var(--gold-soft)\}\
.about-sub\{margin-top:20px;font-size:15px;color:var(--muted)\}\
.about-sub button\{color:var(--gold-dk);text-decoration:underline;text-underline-offset:3px;font-weight:600\}\
\
@media(max-width:700px)\{\
  .wrap\{padding:0 16px\}\
  .how,.stats\{grid-template-columns:1fr\}\
  .stat\{border-right:none;border-bottom:1px solid var(--rule)\}\
  .stat:last-child\{border-bottom:none\}\
  nav\{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none\}\
  nav::-webkit-scrollbar\{display:none\}\
  nav button\{white-space:nowrap\}\
  .authcard\{padding:38px 24px 30px\}\
  .splash\{padding:54px 18px 58px\}\
  .splash .mark.xl\{width:76px;height:76px;margin-bottom:22px\}\
  .wm .nmx\{font-size:38px;letter-spacing:.1em\}\
  .wm .the\{font-size:30px\}\
  .manifesto\{margin-top:44px\}\
  .manifesto p\{font-size:20px\}\
  .abhero\{padding:50px 18px 54px\}\
  .abhero h2\{font-size:32px\}\
  .about-body\{padding-top:40px\}\
  .about-body .lede\{font-size:26px\}\
  .joincta .jt\{font-size:22px\}\
  .hero\{padding:26px 18px 22px\}\
  .hero .mo\{font-size:26px\}\
  .sides,.chs,.gavel\{grid-template-columns:1fr\}\
  .side.f\{border-right:none;border-bottom:1px solid var(--rule)\}\
  .big\{font-size:64px\}\
  .bars\{grid-template-columns:46px 1fr 62px\}\
  .row,.pr\{grid-template-columns:1fr;gap:4px\}\
  .mem\{grid-template-columns:1fr 60px;gap:8px\}\
  .mem .rl,.mem .hd2:nth-child(2)\{display:none\}\
  nav button\{margin-right:14px\}\
  .hi\{padding-right:16px;margin-right:16px\}\
\}\
</style>\
</head>\
<body>\
\
<!-- ================= AUTH MODAL ================= -->\
<div class="authwrap" id="authModal" role="dialog" aria-modal="true" aria-label="Sign in or join the National Union">\
  <div class="authcard">\
    <button class="authclose" id="authX" aria-label="Close">&times;</button>\
    <span class="cn nw"></span><span class="cn ne"></span><span class="cn sw"></span><span class="cn se"></span>\
    <div class="lbox">\
