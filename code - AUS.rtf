/* ---------- nav ---------- */\
function go(p)\{\
  const btn=document.querySelector('nav button[data-p="'+p+'"]');\
  if(btn)\{\
    if(btn.classList.contains('ldr')&&!(S.auth&&S.role==='leader'))\{openAuth('signin');return\}\
    if(btn.classList.contains('mbr')&&!S.auth)\{openAuth('signin');return\}\
  \}\
  document.querySelectorAll('nav button').forEach(x=>\{\
    const sel=x.dataset.p===p;\
    x.setAttribute('aria-selected',sel?'true':'false');\
    x.tabIndex=sel?0:-1;               // roving tabindex, as a tablist expects\
  \});\
  document.querySelectorAll('.page').forEach(x=>x.classList.toggle('on',x.id===p));\
  window.scrollTo(0,0);\
\}\
document.querySelectorAll('nav button').forEach(b=>\{\
  b.id='tab-'+b.dataset.p;\
  b.setAttribute('aria-controls',b.dataset.p);\
  b.tabIndex=b.getAttribute('aria-selected')==='true'?0:-1;\
  const panel=$(b.dataset.p);\
  if(panel)panel.setAttribute('aria-labelledby',b.id);\
  b.onclick=()=>go(b.dataset.p);\
\});\
$('nav').addEventListener('keydown',e=>\{\
  const k=\{ArrowLeft:-1,ArrowRight:1,Home:'first',End:'last'\}[e.key];\
  if(k===undefined)return;\
  const tabs=[...document.querySelectorAll('nav button')].filter(b=>b.offsetParent!==null);\
  const at=tabs.indexOf(document.activeElement);\
  if(at<0)return;\
  e.preventDefault();\
  const to=k==='first'?0:k==='last'?tabs.length-1:(at+k+tabs.length)%tabs.length;\
  tabs[to].focus();go(tabs[to].dataset.p);\
\});\
