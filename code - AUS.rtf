/* ---------- timeline ----------\
   Every date on the site is derived from today, so the demo never goes stale.\
   MTG[0] is the next debate; meetings run every other Thursday at 7:00 PM. */\
const DOW=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];\
const DOWF=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\
const MONF=['January','February','March','April','May','June','July','August','September','October','November','December'];\
function addDays(d,n)\{const x=new Date(d);x.setDate(x.getDate()+n);return x\}  // DST-safe\
function nextThu(minDays)\{                        // first Thursday at least minDays out\
  const d=new Date();d.setHours(19,0,0,0);\
  d.setDate(d.getDate()+minDays);\
  d.setDate(d.getDate()+((4-d.getDay()+7)%7));    // 4 = Thursday\
  return d;\
\}\
const MTG=[];\{const f=nextThu(4);for(let k=0;k<6;k++)MTG.push(addDays(f,k*14))\}\
const fShort=d=>DOW[d.getDay()]+' '+d.getDate()+' '+MON[d.getMonth()];\
const fLong =d=>DOW[d.getDay()]+' '+d.getDate()+' '+MONF[d.getMonth()];\
const fFull =d=>DOWF[d.getDay()]+' '+d.getDate()+' '+MONF[d.getMonth()];\
const fArc  =d=>d.getDate()+' '+MON[d.getMonth()]+' '+d.getFullYear();\
const fDay  =d=>d.getDate()+' '+MONF[d.getMonth()];\
const fClock=d=>\{const h=d.getHours();return (h%12||12)+':'+String(d.getMinutes()).padStart(2,'0')+' '+(h<12?'AM':'PM')\};\
let VOTE_CLOSE=addDays(MTG[0],9);    // shortlist ballot for Meeting 5 \'97 editable in Settings\
let SUB_CLOSE =addDays(MTG[0],23);   // topic submissions for Meeting 6 \'97 editable in Settings\
function calcSeason()\{   // recomputed each call so it stays right if the schedule moves\
  const y=MTG[0].getFullYear(),s=MTG[0].getMonth()>=6?y:y-1;   // season rolls in July\
  return s+'\'96'+String(s+1).slice(2);\
\}\
function toLocalInput(d)\{   // Date -> value a datetime-local input accepts\
  const p=n=>String(n).padStart(2,'0');\
  return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());\
\}\
\
function fillDates()\{\
  const set=(id,t)=>\{const e=$(id);if(e)e.textContent=t\};\
  set('heroWhen',fLong(MTG[0])+', '+fClock(MTG[0]));\
  set('heroThesis','Selected speakers: submit your one-line thesis by '+fFull(addDays(MTG[0],-2))+\
    ', '+fClock(MTG[0])+'. A speaker who does not confirm is replaced by the reserve.');\
  document.querySelectorAll('[data-mt]').forEach(e=>e.textContent=fShort(MTG[+e.dataset.mt]));\
  set('schedVote','Voting closes '+fDay(VOTE_CLOSE));\
  set('schedSub1','Submissions close '+fDay(SUB_CLOSE));\
  set('schedSub2','Submissions open '+fDay(addDays(MTG[2],1)));\
  set('voteK','Meeting 5 \'b7 Closes '+fDay(VOTE_CLOSE));\
  set('subK','Meeting 6 \'b7 Open until '+fDay(SUB_CLOSE));\
  const ac=$('ac5'); if(ac) ac.value='Meeting 4, '+fDay(MTG[0]);\
  set('schedSeason',calcSeason()+' \'b7 Seattle Academy');\
\}\
