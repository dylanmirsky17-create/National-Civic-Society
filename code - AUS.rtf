    $('roleswap').textContent=lead?'switch to member':'switch to leader';\
  \}\
  const cur=document.querySelector('nav button[aria-selected="true"]');\
  if(cur)\{\
    const needAuth=cur.classList.contains('mbr')||cur.classList.contains('ldr');\
    const needLead=cur.classList.contains('ldr');\
    if((needAuth&&!on)||(needLead&&!lead))\{halt();go('home')\}   // never leave the debate clock running\
  \}\
\}\
$('roleswap').onclick=()=>\{S.role=S.role==='leader'?'member':'leader';applyAuth()\};\
$('logout').onclick=()=>\{\
  halt();                       // never leave a debate clock running after sign-out\
