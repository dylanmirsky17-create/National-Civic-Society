    const mk=s.stop===1?'|':s.stop===2?'||':'';\
    const h='<div class="rr" data-k="'+k+'"><div class="rt2 tn">'+fmt(t)+'</div>'+\
      '<div class="rl2">'+(mk?'<span class="mk">'+mk+'</span>':'')+s.n+'</div>'+\
      '<div class="rd2 tn">'+fmt(s.d)+'</div></div>';\
    t+=s.d;return h;\
  \}).join('');\
  document.querySelectorAll('.rr').forEach(r=>r.onclick=()=>seek(+r.dataset.k));\
\}\
function paint()\{\
  const s=SEG[i];\
  $('cph').textContent=s.ph;$('cnow').textContent=s.n;$('cnote').textContent=s.note||'';\
  const big=$('big');big.textContent=fmt(left);big.classList.toggle('warn',left<=10);\
  $('upnext').textContent=SEG[i+1]?SEG[i+1].n:'Debate ends';\
  let e=0;for(let k=0;k<i;k++)e+=SEG[k].d;\
  $('elapsed').textContent=fmt2(e+(SEG[i].d-left))+' / '+fmt2(total());\
  const g=$('gcue');\
  g.textContent = left<=10&&s.stop===1 ? '| One strike. Wrap it'\
    : left<=10&&s.stop===2 ? '|| Two strikes. Done' : '';\
  document.querySelectorAll('.rr').forEach(r=>\{\
    const k=+r.dataset.k;r.classList.toggle('cur',k===i);r.classList.toggle('done',k<i);\
  \});\
\}\
function tick()\{ if(left>0)\{left--;paint()\} else \{$('gcue').textContent='|| Two strikes. Done';halt()\} \}\
function run()\{running=true;timer=setInterval(tick,1000);$('play').textContent='Pause'\}\
function halt()\{running=false;clearInterval(timer);$('play').textContent='Start'\}\
function seek(k)\{halt();i=Math.max(0,Math.min(SEG.length-1,k));left=SEG[i].d;paint()\}\
$('play').onclick=()=>running?halt():run();\
$('nextb').onclick=()=>\{if(i<SEG.length-1)seek(i+1)\};\
$('reset').onclick=()=>seek(0);\
\
/* ---------- admin: timing editor ---------- */\
function buildEd()\{\
  $('ted').innerHTML=SEG.map((s,k)=>\{\
    const mk=s.stop===1?'|':s.stop===2?'||':'';\
    return '<div class="ted"><div class="nm2">'+(mk?'<span class="mk">'+mk+'</span>':'')+s.n+'</div>'+\
      '<input data-k="'+k+'" value="'+fmt(s.d)+'"></div>';\
  \}).join('');\
  document.querySelectorAll('#ted input').forEach(inp=>inp.oninput=recalc);\
  recalc();\
\}\
function parseT(v)\{\
  const p=String(v).split(':');\
  if(p.length===2)\{const m=+p[0],s=+p[1];if(!isNaN(m)&&!isNaN(s))return m*60+s\}\
  const n=+v;return isNaN(n)?null:n;\
\}\
function recalc()\{\
  let t=0,bad=false;\
  document.querySelectorAll('#ted input').forEach(inp=>\{\
    const v=parseT(inp.value);\
    if(v===null||v<5)\{bad=true;inp.style.borderColor='var(--cl)'\}\
    else\{inp.style.borderColor='';t+=v\}\
  \});\
  const buf=SET.lenMin*60-t;\
  $('tsc').textContent=fmt2(t);\
  const b=$('tsb');b.textContent=(buf<0?'\uc0\u8722 ':'')+fmt2(Math.abs(buf));\
  b.classList.toggle('over',buf<0);\
  $('tnote').textContent = bad ? 'Check the highlighted fields'\
    : buf<0 ? 'Over the '+SET.lenMin+'-minute meeting' : 'Applies to the Chair console';\
\}\
$('tsave').onclick=()=>\{\
  let ok=true;\
  document.querySelectorAll('#ted input').forEach(inp=>\{\
    const v=parseT(inp.value);\
    if(v===null||v<5)\{ok=false;return\}\
    SEG[+inp.dataset.k].d=v;\
  \});\
  if(!ok)\{recalc();return\}\
  halt();i=0;left=SEG[0].d;buildList();paint();buildEd();\
  $('tsave').textContent='Applied';setTimeout(()=>$('tsave').textContent='Apply',1200);\
\};\
$('tdefault').onclick=()=>\{SEG=DEF.map(s=>(\{...s\}));halt();i=0;left=SEG[0].d;buildList();paint();buildEd()\};\
\
/* ---------- settings ---------- */\
function buildSchedEd()\{\
  $('schedEd').innerHTML=MTG.map((d,k)=>\
    '<div class="sed"><div class="nm2">Meeting '+(k+1)+'</div>'+\
    '<input type="datetime-local" data-k="'+k+'" value="'+toLocalInput(d)+'"></div>'\
  ).join('');\
\}\
$('schedSave').onclick=function()\{\
  let ok=true;\
  document.querySelectorAll('#schedEd input').forEach(inp=>\{\
    if(!inp.value)\{ok=false;inp.style.borderColor='var(--cl)';return\}\
    inp.style.borderColor='';\
    MTG[+inp.dataset.k]=new Date(inp.value);\
  \});\
  if(!ok)return;\
  fillDates();\
  this.textContent='Saved';setTimeout(()=>this.textContent='Save schedule',1200);\
\};\
$('schedDefault').onclick=function()\{\
  const f=nextThu(4);\
  for(let k=0;k<MTG.length;k++) MTG[k]=addDays(f,k*14);\
  buildSchedEd();fillDates();\
\};\
$('setVoteSave').onclick=function()\{\
  if($('setVote').value) VOTE_CLOSE=new Date($('setVote').value);\
  if($('setSub').value)  SUB_CLOSE =new Date($('setSub').value);\
  fillDates();\
  this.textContent='Saved';setTimeout(()=>this.textContent='Save',1200);\
\};\
$('setMiscSave').onclick=function()\{\
  SET.room=$('setRoom').value.trim()||SET.room;\
  const len=+$('setLen').value;\
  if(len>=10) SET.lenMin=len;\
  applySettings();\
  this.textContent='Saved';setTimeout(()=>this.textContent='Save',1200);\
\};\
function applySettings()\{\
  $('heroRoom').textContent=SET.room;\
  $('heroLen').textContent=SET.lenMin+' minutes';\
  $('chairRoom').textContent=SET.room;\
  $('tsMeeting').textContent=fmt2(SET.lenMin*60);\
  recalc();\
\}\
function buildSettings()\{\
  buildSchedEd();\
  $('setVote').value=toLocalInput(VOTE_CLOSE);\
  $('setSub').value=toLocalInput(SUB_CLOSE);\
  $('setRoom').value=SET.room;\
  $('setLen').value=SET.lenMin;\
\}\
\
/* ---------- admin: reports ---------- */\
const REPS=[\
 \{id:'R-0042',new:1,b:'One person took most of the open forum in Meeting 3 and the chair didn\\'t call it. It happened in Meeting 2 as well. It\\'s the same person both times.',m:'Conduct in a debate \'b7 2 days ago'\},\
 \{id:'R-0041',new:1,b:'I wanted to speak from the floor but the two people who went first were clearly set up in advance and it made it feel like a closed thing. I didn\\'t know that was the rule.',m:'How the society is run \'b7 5 days ago'\},\
 \{id:'R-0038',new:0,b:'The room was told the vote was anonymous but the QR link showed our names on the form. Please check that.',m:'How the society is run \'b7 3 weeks ago \'b7 Resolved'\}\
];\
$('repbox').innerHTML=REPS.map(r=>\
 '<div class="rep"><div class="rh"><span class="id">'+r.id+'</span>'+\
 '<span class="tg '+(r.new?'new':'seen')+'">'+(r.new?'Unread':'Reviewed')+'</span></div>'+\
 '<div class="bd">'+r.b+'</div><div class="mt">'+r.m+'</div></div>').join('');\
$('repcount').textContent=REPS.filter(r=>r.new).length;\
\
fillDates();buildList();paint();buildEd();buildSettings();applySettings();applyAuth();\
</script>\
</body>\
</html>}