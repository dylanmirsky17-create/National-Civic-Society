<!-- ---- HOME ---- -->\
<div class="page on" id="home" role="tabpanel">\
\
  <!-- Public: the grand entrance -->\
  <div id="homeGuest">\
    <section class="splash">\
      <div class="wrap">\
        <svg class="mark xl" viewBox="0 0 100 100" aria-label="National Union">\
          <g fill="none" stroke="#D4AF37" stroke-width="1.6" stroke-linecap="round">\
            <path d="M26 18 C10 42 14 68 40 84"/><path d="M74 18 C90 42 86 68 60 84"/>\
            <path d="M42 85 Q50 79 58 85"/><path d="M43 90 L38 96"/><path d="M57 90 L62 96"/>\
          </g>\
          <g fill="#D4AF37">\
            <ellipse cx="24" cy="30" rx="4.6" ry="2.4" transform="rotate(-38 24 30)"/>\
            <ellipse cx="21" cy="42" rx="4.6" ry="2.4" transform="rotate(-16 21 42)"/>\
            <ellipse cx="22" cy="54" rx="4.6" ry="2.4" transform="rotate(8 22 54)"/>\
            <ellipse cx="27" cy="66" rx="4.6" ry="2.4" transform="rotate(28 27 66)"/>\
            <ellipse cx="35" cy="76" rx="4.6" ry="2.4" transform="rotate(46 35 76)"/>\
            <ellipse cx="76" cy="30" rx="4.6" ry="2.4" transform="rotate(38 76 30)"/>\
            <ellipse cx="79" cy="42" rx="4.6" ry="2.4" transform="rotate(16 79 42)"/>\
            <ellipse cx="78" cy="54" rx="4.6" ry="2.4" transform="rotate(-8 78 54)"/>\
            <ellipse cx="73" cy="66" rx="4.6" ry="2.4" transform="rotate(-28 73 66)"/>\
            <ellipse cx="65" cy="76" rx="4.6" ry="2.4" transform="rotate(-46 65 76)"/>\
            <path d="M50 20 l2.4 5 5.4.6 -4 3.7 1.1 5.4 -4.9-2.8 -4.9 2.8 1.1-5.4 -4-3.7 5.4-.6z"/>\
          </g>\
        </svg>\
        <div class="wm"><span class="the">the</span><span class="nmx">National Union</span></div>\
        <div class="splash-tag">Bringing free speech, challenging conversations, and critical thinking to high schools across America</div>\
        <div class="splash-cta">\
          <button class="topbtn solid" id="splashJoin">Join</button>\
          <button class="topbtn" id="splashAbout">What we're about</button>\
        </div>\
      </div>\
    </section>\
\
    <div class="wrap">\
      <div class="manifesto">\
        <p>Most of what you believe, you have never actually had to argue for.</p>\
        <a class="amp" href="#" data-goto="about">Read what we're about</a>\
      </div>\
\
      <h3 class="sec gap">How our debates work</h3>\
      <div class="how">\
        <div class="c2"><div class="n">01</div><div class="t">The room votes first</div><div class="w">Everyone votes on the motion before anyone speaks. It is a private ballot by QR code.</div></div>\
        <div class="c2"><div class="n">02</div><div class="t">Both sides make the case</div><div class="w">Openings, two rounds of open forum, then closings. The floor is open to any member and there is no sign-up to speak.</div></div>\
        <div class="c2"><div class="n">03</div><div class="t">The room votes again</div><div class="w">The side that changes more minds wins, even if it finishes in the minority.</div></div>\
