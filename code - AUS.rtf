/* ---------- session ---------- */\
function login(role)\{S.auth=true;S.role=role;applyAuth();closeAuth();go('home');window.scrollTo(0,0)\}\
$('dosignin').onclick=()=>login('leader');   // demo: sign in as the chapter's president\
