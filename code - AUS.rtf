        <path d="M50 20 l2.4 5 5.4.6 -4 3.7 1.1 5.4 -4.9-2.8 -4.9 2.8 1.1-5.4 -4-3.7 5.4-.6z"/>\
      </g>\
    </svg>\
    <h1><span class="the" style="display:block;font-size:26px;color:var(--gold-soft);letter-spacing:.02em;margin-bottom:6px">the</span>National<br>Union</h1>\
    <div class="tag">Since 2025</div>\
    <div class="lrule"><i></i></div>\
\
    <div id="signin">\
      <div class="lf"><label for="e1">Email</label><input id="e1" type="email" placeholder="you@yourschool.org"></div>\
      <div class="lf"><label for="p1">Password</label><input id="p1" type="password" placeholder="\'95\'95\'95\'95\'95\'95\'95\'95"></div>\
      <button class="lbtn" id="dosignin">Sign in</button>\
      <div class="lalt">No account? <button id="toreg">Create one</button></div>\
    </div>\
\
    <div id="reg" style="display:none">\
      <div class="lf"><label for="n2">Full name</label><input id="n2" placeholder="First and last"></div>\
      <div class="lf"><label for="e2">School email</label><input id="e2" type="email" placeholder="you@yourschool.org"></div>\
      <div class="lf">\
        <label for="s2">Your school</label>\
        <select id="s2">\
          <option>Seattle Academy of Arts and Sciences (SAAS)</option>\
          <option>Lakeside School</option>\
          <option>Gonzaga Preparatory School</option>\
          <option>Bellevue High School</option>\
          <option>Olympia High School</option>\
          <option>Bellingham High School</option>\
          <option value="__req">Request a chapter (my school isn't listed)</option>\
        </select>\
        <div class="h">No chapter at your school yet? Choose the last option to start one.</div>\
      </div>\
      <div class="lf"><label for="p2">Password</label><input id="p2" type="password"></div>\
      <button class="lbtn" id="doreg">Create account</button>\
      <div class="lalt">Have an account? <button id="tosignin">Sign in</button></div>\
    </div>\
\
    <div class="demohint">Demo. Any email and password signs you in. No account is created.</div>\
\
    </div>\
  </div>\
</div>\
